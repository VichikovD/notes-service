#!/usr/bin/env bash
#
# commit-msg: enforce Conventional Commits format.
#   <type>(optional scope)(optional !): <subject>
# Allowed types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
#
set -euo pipefail

MSG_FILE="$1"
SUBJECT="$(head -n1 "$MSG_FILE")"

# Allow merge commits and revert commits generated by git.
if printf '%s' "$SUBJECT" | grep -qE '^(Merge|Revert)'; then
  exit 0
fi

PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?(!)?: .{1,100}$'

if ! printf '%s' "$SUBJECT" | grep -qE "$PATTERN"; then
  echo "[commit-msg] ERROR: commit message does not follow Conventional Commits."
  echo "[commit-msg] Got:      $SUBJECT"
  echo "[commit-msg] Expected: <type>(scope): <subject>"
  echo "[commit-msg] Types:    feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  exit 1
fi

echo "[commit-msg] OK"
